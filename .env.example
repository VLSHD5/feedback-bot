# Telegram
BOT_TOKEN=
# Comma-separated Telegram usernames and/or numeric IDs of the owner/admins.
ADMIN_USERNAMES=VLSHD5
ADMIN_IDS=
# Optional initial group IDs. Additional groups can be connected with /connect.
MODERATION_CHAT_IDS=

# Storage
DB_PATH=data/bot.db
BAD_WORDS_PATH=data/bad_words.txt

# Moderation
PROFANITY_MUTE_MINUTES=30
MAX_WARNINGS=3
ANTISPAM_MESSAGES=5
ANTISPAM_WINDOW=10

# Mini App (GitHub Pages). Must be HTTPS for Telegram Web Apps.
# After GitHub Pages is active use: https://feedback-bot.com
WEBAPP_URL=https://feedback-bot.com

# Local AI / Shieldstral via llama.cpp OpenAI-compatible server
AI_ENABLED=true
AI_BASE_URL=http://127.0.0.1:9931/v1
AI_API_KEY=local
AI_MODEL=
AI_ACTION=warn
AI_MUTE_MINUTES=30
AI_CONCURRENCY=1
AI_MAX_CHARS=2500
AI_TIMEOUT_SECONDS=30
