[Unit]
Description=Telegram Feedback Bot + Shieldstral
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jdh-admin
WorkingDirectory=/home/jdh-admin/feedback_bot
ExecStart=/home/jdh-admin/feedback_bot/start.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
